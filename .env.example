# ── Base de données ─────────────────────────────────────────────────────────
# SQLite en local. En production : provider "postgresql" dans prisma/schema.prisma
# et DATABASE_URL="postgresql://user:password@host:5432/missionia".
DATABASE_URL="file:./dev.db"

# ── Authentification ────────────────────────────────────────────────────────
# Secret de signature des sessions (JWT en cookie httpOnly). 32+ caractères aléatoires.
AUTH_SECRET="change-me-with-a-long-random-string"

# ── IA (phases 16 à 18) ─────────────────────────────────────────────────────
# "stub" = fournisseur déterministe hors-ligne, sans clé ni coût.
AI_PROVIDER="stub"
# ANTHROPIC_API_KEY=""
# AI_MODEL=""

# ── Stockage de fichiers (phase 8/9) ────────────────────────────────────────
# "local" = dossier privé ./storage (jamais servi statiquement). Alternative : "s3".
FILE_STORAGE="local"
FILE_STORAGE_DIR="./storage"

# ── Application ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
