# MySQL connection string. Locally you need a reachable MySQL instance
# (Docker: `docker run -e MYSQL_ROOT_PASSWORD=password -p 3306:3306 mysql:8`).
# In production this is colocated with the web host (see README).
DATABASE_URL="mysql://user:password@localhost:3306/the_apprentice"
# Secret used to sign session JWTs. Generate a strong random value in production.
JWT_SECRET="change-me"
# Optional: enable a real AI provider for The Coach / generation features (see src/lib/ai/ai-service.ts).
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
