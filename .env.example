# EscapeClass — variables d'environnement
# SQLite en local/dev. En production : provider "postgresql" dans prisma/schema.prisma + URL Postgres.
DATABASE_URL="file:./dev.db"
# Secret de signature des sessions (JWT). Générer une valeur aléatoire forte en production.
JWT_SECRET="change-me-escapeclass"
# URL publique de l'application (QR codes, liens de session).
APP_URL="http://localhost:3000"
# IA (optionnel) : "stub" (par défaut, hors-ligne) ou "anthropic".
# AI_PROVIDER="stub"
# ANTHROPIC_API_KEY=""
