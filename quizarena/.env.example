# --- Database -----------------------------------------------------------
# SQLite for local development (zero infrastructure). For production, switch
# `provider` to "postgresql" in prisma/schema.prisma and point this at Postgres.
DATABASE_URL="file:./dev.db"

# --- Auth ---------------------------------------------------------------
# Secret used to sign session cookies (trainer sessions + player sessions).
# Generate a strong random value in production: `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string"

# --- App ----------------------------------------------------------------
# Public base URL, used to build the "join" link shown in the lobby.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI (optional) ------------------------------------------------------
# Provider used by AIService. "stub" works offline and needs no key.
# Supported: stub | anthropic
AI_PROVIDER="stub"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
